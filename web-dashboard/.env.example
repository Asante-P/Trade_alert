# Backend Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Application Configuration
NEXT_PUBLIC_APP_NAME=Trade Alert Dashboard
NEXT_PUBLIC_APP_VERSION=1.0.0

# API Configuration
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_REFRESH_INTERVAL=15000

# Market Data APIs
TWELVE_DATA_API_KEY=your_twelvedata_api_key

# Economic Data APIs
# Finance Calendar API is used by default (free, no API key required)
# Optional: Configure Trading Economics or FRED for additional data sources
TRADING_ECONOMICS_API_KEY=your_trading_economics_api_key # Optional
FRED_API_KEY=your_fred_api_key # Optional

# WebSocket Configuration
WEBSOCKET_URL=ws://localhost:8080
WEBSOCKET_API_KEY=your_websocket_api_key

# Notification Services
# Email (SMTP or service like SendGrid, Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL=your_notification_email@gmail.com

# SMS (Twilio or similar)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
NOTIFICATION_PHONE_NUMBER=+0987654321

# Webhook Notifications
ALERT_WEBHOOK_URL=https://your-webhook-endpoint.com/alerts
WEBHOOK_SECRET=your_webhook_secret_key

# Feature Flags
NEXT_PUBLIC_ENABLE_MARKET_DATA=true
NEXT_PUBLIC_ENABLE_MTF_ANALYSIS=true
NEXT_PUBLIC_ENABLE_AI_ANALYZER=true
NEXT_PUBLIC_ENABLE_REALTIME_PRICES=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
